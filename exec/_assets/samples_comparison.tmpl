import bpy
import time

scene = bpy.data.scenes["{{ .Scene }}"]
sample_list = [{{ .SamplesList }}]
frame_number = {{ .Frame }}
scene.frame_set(frame_number)

for s in sample_list:
    print(f"BRENDER_SAMPLES_START {s}")
{{ if .IsCycles }}
    scene.cycles.samples = s
{{ else if .IsEevee }}
    scene.eevee.taa_render_samples = s
{{ else if .IsWorkbench }}
    scene.display.render_aa = str(s)
{{ end }}
    scene.render.filepath = "{{ .OutputDir }}/frame_samples" + str(s)
    start = time.time()
    bpy.ops.render.render(write_still=True)
    elapsed = time.time() - start
    print(f"BRENDER_SAMPLES_DONE {s} {elapsed:.2f}")

print("Blender quit")
