import bpy
from collections import defaultdict

def printScenes():

    current = bpy.context.scene
    scenes = bpy.data.scenes

    print("{{ .SceneStartFlag }}")
    for key, value in scenes.items():
        cur = 0
        if key == current.name:
          cur = 1

        row = []
        start = value.frame_start
        end   = value.frame_end

        cam   = value.camera.name
        x     = value.render.resolution_x
        y     = value.render.resolution_y
        eng   = value.render.engine

        row.append(str(cur))
        row.append(str(start))
        row.append(str(end))
        row.append(key)
        row.append(cam)
        row.append(str(x))
        row.append(str(y))
        row.append(eng)

        print("\t".join(row))

    print("{{ .SceneEndFlag }}")

def printCameras():

    camera_usage = defaultdict(list)

    for scene in bpy.data.scenes:
        # そのシーン内の全オブジェクトをループ
        for obj in scene.objects:
            # オブジェクトがカメラだった場合
            if obj.type == 'CAMERA':
                camera_usage[obj.name].append(scene.name)

    print("{{ .CameraStartFlag }}")

    for cam_name, scene_names in camera_usage.items():

        row = []
        scenes_str = ",".join(scene_names)
        row.append(cam_name)
        row.append(scenes_str)
        print("\t".join(row))

    print("{{ .CameraEndFlag }}")

if __name__ == "__main__":
    print("{{ .ToolStartFlag }}")
    printScenes()
    printCameras()
    print("{{ .ToolEndFlag }}")
